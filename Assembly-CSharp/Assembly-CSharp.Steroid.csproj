<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Assembly-CSharp.Steroid.mm</AssemblyName>
        <Version>0.0.7</Version>
        <TargetFramework>net35</TargetFramework>
        <Company>oshinop</Company>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Platforms>x64</Platforms>
        <Configurations>Debug;Release</Configurations>
        <NoWarn>IDE0044,IDE0051,IDE0052,IDE1006,CS0414,CS0649,CS0626</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <Mu3ReferenceDir>$(MSBuildThisFileDirectory)..\..\mu3-reference</Mu3ReferenceDir>
        <Mu3ReferenceLibDir>$(Mu3ReferenceDir)\lib</Mu3ReferenceLibDir>
        <AssetBundlesDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../UnityAssets/Build'))</AssetBundlesDir>
        <NativeLibrariesDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Native/Build'))</NativeLibrariesDir>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <OutputPath>..\bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE;ENABLE_PROFILER</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>..\bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="mscorlib"><HintPath>$(Mu3ReferenceLibDir)\mscorlib.dll</HintPath></Reference>
        <Reference Include="UnityEngine"><HintPath>$(Mu3ReferenceLibDir)\UnityEngine.dll</HintPath></Reference>
        <Reference Include="UnityEngine.UI"><HintPath>$(Mu3ReferenceLibDir)\UnityEngine.UI.dll</HintPath></Reference>
        <ProjectReference Include="$(Mu3ReferenceDir)\Assembly-CSharp-firstpass\Assembly-CSharp-firstpass.csproj" />
        <ProjectReference Include="$(Mu3ReferenceDir)\AMDaemon.NET\AMDaemon.NET.csproj" />
        <ProjectReference Include="$(Mu3ReferenceDir)\Assembly-CSharp\Assembly-CSharp.csproj" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="monomod" Version="20.5.21.5" />
        <Compile Include="..\Common\**\*.cs" Link="Common\%(RecursiveDir)%(Filename)%(Extension)" />
        <AssetBundleFile Include="$(AssetBundlesDir)/*" />
        <EmbeddedResource Include="@(AssetBundleFile)" LogicalName="MU3.Mod.Assets.Res.%(Filename)%(Extension)" />
        <NativeLibraryFile Include="$(NativeLibrariesDir)/*" />
        <EmbeddedResource Include="@(NativeLibraryFile)" LogicalName="MU3.Mod.Native.Res.%(Filename)%(Extension)" />

    </ItemGroup>
</Project>

